#!/bin/bash
# TrollShot deb 安装后自动加载 daemon

echo "TrollShot: 正在配置..."

# 清除停止标志（安装/升级时确保 daemon 能正常启动）
rm -f /tmp/trollshotd.stop

# 修复权限（deb 安装可能保留错误的 owner）
chown root:wheel /usr/bin/trollshotd 2>/dev/null
chmod 755 /usr/bin/trollshotd 2>/dev/null
chown root:wheel /usr/bin/trollshotd_wrapper.sh 2>/dev/null
chmod 755 /usr/bin/trollshotd_wrapper.sh 2>/dev/null
chown root:wheel /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null
chmod 644 /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null

echo "TrollShot: 正在加载 launchd daemon..."

# 先卸载旧实例
launchctl bootout system/com.hogan.trollshot 2>/dev/null
killall -9 trollshotd 2>/dev/null
sleep 1

# 加载 LaunchDaemon（以 root 运行，deb 安装后就是 root）
launchctl load -w /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null

# 等待端口就绪
sleep 2

# 检查 daemon 是否在运行
if launchctl list 2>/dev/null | grep -q com.hogan.trollshot; then
    echo "TrollShot: daemon 已启动"
else
    echo "TrollShot: daemon 未自动启动，请手动执行："
    echo "  launchctl load -w /Library/LaunchDaemons/com.hogan.trollshot.plist"
fi

exit 0
