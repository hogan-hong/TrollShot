#!/bin/bash
# TrollShot deb 安装后自动加载 daemon

echo "TrollShot: 正在配置..."

# 清除停止标志（安装/升级时确保 daemon 能正常启动）
rm -f /var/mobile/trollshot/stop.flag

# 确保 /var/mobile/trollshot 目录存在
mkdir -p /var/mobile/trollshot

# 目录归属修正为 mobile：TrollShot App 以 mobile 身份运行，改端口需写 api_port、
# 启动服务需删 stop.flag；本脚本以 root 执行 mkdir，若不修正归属，App 的这两个操作
# 都会静默失败（实测 172.16.103.104：改端口后界面回弹 6688、点"启动服务"超时）。
# daemon 以 root 运行，不受归属影响。旧版本设备升级安装时自动修复，无需手工处理。
chown -R mobile:mobile /var/mobile/trollshot 2>/dev/null

# 修复权限（deb 安装可能保留错误的 owner）
chown root:wheel /usr/bin/trollshotd 2>/dev/null
chmod 755 /usr/bin/trollshotd 2>/dev/null
chown root:wheel /usr/bin/trollshotd_wrapper.sh 2>/dev/null
chmod 755 /usr/bin/trollshotd_wrapper.sh 2>/dev/null
chown root:wheel /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null
chmod 644 /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null

echo "TrollShot: 正在加载 launchd daemon..."

# 先卸载旧实例
launchctl bootout system/com.hogan.trollshot 2>/dev/null
killall -9 trollshotd 2>/dev/null
killall -9 trollshotd_wrapper.sh 2>/dev/null
sleep 1

# 加载 LaunchDaemon
# 注意：iOS 14.1 越狱环境实测 launchctl bootstrap 返回 0 但 job 并未真正加载（假成功），
# 因此优先使用 load -w（实测可靠），并以 launchctl list 实际状态为准验证，失败再试 bootstrap。
launchctl load -w /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null
if ! launchctl list 2>/dev/null | grep -q com.hogan.trollshot; then
    launchctl bootstrap system /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null
fi

# 等待端口就绪
sleep 2

# 检查 daemon 是否在运行（以 launchctl list 实际状态为准）
if launchctl list 2>/dev/null | grep -q com.hogan.trollshot; then
    echo "TrollShot: daemon 已启动（开机后将自动启动）"
else
    echo "TrollShot: daemon 未自动启动，请手动执行："
    echo "  launchctl load -w /Library/LaunchDaemons/com.hogan.trollshot.plist"
fi

# 重建图标缓存（卸载重装/异常安装后 SpringBoard 图标缓存可能不刷新，导致桌面无图标、
# 资源库搜不到；respring 的自动重扫并不总是可靠，必须显式 uicache）
if [ -d /Applications/TrollShot.app ]; then
    echo "TrollShot: 正在重建图标缓存..."
    uicache -p /Applications/TrollShot.app >/dev/null 2>&1 || uicache >/dev/null 2>&1
fi

# respring 加载 airplay-autolink tweak（注入 SB 的 dylib 必须 respring 才生效；
# 注意 Theos 的 after-install 只在 make install 流程执行，dpkg -i 走本脚本，必须在此处理）。
# 按安装途径区分（2026-08-17 幽灵安装事故后修订）：
# - GUI 包管理器（Zebra/Sileo）安装：本脚本不杀 SpringBoard。包内含 MobileSubstrate
#   tweak，GUI 安装完成页会自动出现"重启 SpringBoard"按钮，由用户点击触发（与其他
#   插件行为一致）；若脚本自行 respring，会打断 GUI 内连续安装队列、甚至再次引发
#   dpkg 状态库写坏（172.16.103.104 幽灵安装：GUI 被斩断后 dpkg 显示已装但文件全无）。
# - SSH/命令行无人值守安装：无人点按钮，延迟 12 秒后台自动 respring（延迟是为了
#   让 dpkg/cydia triggers 先收尾；stdin/stdout 重定向防会话悬挂）。
if [ -f /Library/MobileSubstrate/DynamicLibraries/airplay-autolink.dylib ]; then
    if ps ax 2>/dev/null | grep -iE "zebra|sileo" | grep -v grep >/dev/null 2>&1; then
        echo "TrollShot: 检测到 GUI 包管理器安装，跳过自动 respring（请在完成页点击重启 SpringBoard）"
    else
        echo "TrollShot: 12 秒后自动重启 SpringBoard（加载 AirPlay 自动连接 tweak）..."
        (sleep 12; killall -9 SpringBoard) </dev/null >/dev/null 2>&1 &
    fi
fi

exit 0
