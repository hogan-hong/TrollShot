#!/bin/bash
# TrollShot deb 安装后自动加载 daemon

echo "TrollShot: 正在配置..."

# 清除停止标志（安装/升级时确保 daemon 能正常启动）
rm -f /var/mobile/trollshot/stop.flag

# 确保 /var/mobile/trollshot 目录存在
mkdir -p /var/mobile/trollshot

# 修复权限（deb 安装可能保留错误的 owner）
chown root:wheel /usr/bin/trollshotd 2>/dev/null
chmod 755 /usr/bin/trollshotd 2>/dev/null
chown root:wheel /usr/bin/trollshotd_wrapper.sh 2>/dev/null
chmod 755 /usr/bin/trollshotd_wrapper.sh 2>/dev/null
chown root:wheel /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null
chmod 644 /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null

echo "TrollShot: 正在加载 launchd daemon..."

# 先卸载旧实例
launchctl bootout system/com.hogan.trollshot 2>/dev/null
killall -9 trollshotd 2>/dev/null
killall -9 trollshotd_wrapper.sh 2>/dev/null
sleep 1

# 加载 LaunchDaemon
# 注意：iOS 14.1 越狱环境实测 launchctl bootstrap 返回 0 但 job 并未真正加载（假成功），
# 因此优先使用 load -w（实测可靠），并以 launchctl list 实际状态为准验证，失败再试 bootstrap。
launchctl load -w /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null
if ! launchctl list 2>/dev/null | grep -q com.hogan.trollshot; then
    launchctl bootstrap system /Library/LaunchDaemons/com.hogan.trollshot.plist 2>/dev/null
fi

# 等待端口就绪
sleep 2

# 检查 daemon 是否在运行（以 launchctl list 实际状态为准）
if launchctl list 2>/dev/null | grep -q com.hogan.trollshot; then
    echo "TrollShot: daemon 已启动（开机后将自动启动）"
else
    echo "TrollShot: daemon 未自动启动，请手动执行："
    echo "  launchctl load -w /Library/LaunchDaemons/com.hogan.trollshot.plist"
fi

# 重启 SpringBoard 加载/卸载 airplay-autolink tweak（注入 SB 的 dylib 必须 respring 才生效；
# 注意 Theos 的 after-install 只在 make install 流程执行，dpkg -i 走本脚本，必须在此 respring）
if [ -f /Library/MobileSubstrate/DynamicLibraries/airplay-autolink.dylib ]; then
    echo "TrollShot: 正在重启 SpringBoard 以加载 AirPlay 自动连接 tweak..."
    killall -9 SpringBoard 2>/dev/null || true
fi

exit 0
